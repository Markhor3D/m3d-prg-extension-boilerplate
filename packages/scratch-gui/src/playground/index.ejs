<!DOCTYPE html>
<html>

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="google" value="notranslate">
	<link rel="shortcut icon" href="static/favicon.ico">
	<title><%= htmlWebpackPlugin.options.title %></title>
	<% if (htmlWebpackPlugin.options.sentryConfig) { %>
		<script src="https://cdn.ravenjs.com/3.22.1/raven.min.js" crossorigin="anonymous"></script>
		<script>
			Raven.config(<%= htmlWebpackPlugin.options.sentryConfig %>).install();
		</script>
		<% } %>

	<style>
		#m3d-overlay {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background-color: #5e99f7;
			display: flex;
			justify-content: center;
			align-items: center;
			z-index: 9999;
		}

		.m3d-loader {
			text-align: center;
			color: white;
		}

		.m3d-loading-text {
			font-family: "Arial", sans-serif;
			font-weight: bold;
			font-size: 2rem;
		}

		.m3d-loading-text-class {
			font-size: 1rem;
			font-family: "Arial", sans-serif;
		}

		.m3d-progress-bar {
			width: 100%;
			height: 30px;
			border-radius: 5px;
			/* Rounded corners */
			background-color: rgba(255, 255, 255, 0.1);
			margin-top: 10px;
		}

		.m3d-progress-fill {
			height: 100%;
			border-radius: 5px;
			/* Rounded corners */
			background-color: #fff;
			/* Change this color as needed */
			width: 0%;
			margin: 2px;
			/* Add margin */
		}
	</style>
</head>

<body>
	<div id="m3d-overlay">
		<div class="m3d-loader">
			<p class="m3d-loading-text">Loading...</p>
			<p class="m3d-loading-text-class" id="m3d-loading-percentage">0%</p>
			<div class="m3d-loading-text-class" id="m3d-download-speed"></div>
			<div class="m3d-progress-bar">
				<div class="m3d-progress-fill"></div>
			</div>
		</div>
	</div>

	<script src="m3dloader.js"></script>

	</body>

</html>